# Everything in this file is optional — BeePub starts with no .env at all.

# PostgreSQL. The database is only reachable inside the compose network;
# uncomment to override the defaults.
#POSTGRES_DB=beepub
#POSTGRES_USER=beepub
#POSTGRES_PASSWORD=changeme

# JWT signing secret. Left unset, one is auto-generated on first start and
# persisted in the app_data volume. Set it explicitly (openssl rand -hex 32)
# to control or rotate it — changing it logs every session out.
#SECRET_KEY=

# Pin the image version. The compose default tracks the current release.
#BEEPUB_VERSION=0.13.0

# Access token lifetime in minutes (default: 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Logging format: "console" (pretty, colored) or "json" (machine-readable)
LOG_FORMAT=console

# App port (nginx). The default compose exposes nginx on container port 80 for
# reverse proxies/orchestrators. If you need a direct host port for a plain
# Docker install, add a compose override with `ports: ["${PORT:-80}:80"]`.
PORT=80

# Data volume sources. Defaults are Docker named volumes; set any value to an
# absolute host path to use a bind mount instead, e.g.
# BEEPUB_BOOKS_PATH=/srv/beepub/books
#BEEPUB_POSTGRES_DATA_PATH=postgres_data
#BEEPUB_REDIS_DATA_PATH=redis_data
#BEEPUB_APP_DATA_PATH=app_data
#BEEPUB_BOOKS_PATH=books_data
#BEEPUB_COVERS_PATH=covers_data
#BEEPUB_ILLUSTRATIONS_PATH=illustrations_data

# CORS: comma-separated list of public web origins allowed to call the API.
# Capacitor (capacitor://localhost, ionic://localhost) and localhost browser
# origins on any port are always allowed.
# Example: CORS_ORIGINS=https://beepub.example.com,https://reader.example.com
CORS_ORIGINS=
